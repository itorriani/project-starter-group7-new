import { ComputeService } from "compute-svc";
import { SheetCache } from "./sheet-cache";
import {
  SerializedValue, Sheet, Sparse,
  Value, RCKey, parseKey
} from "@poly-sheets/types";



function createRouter(
  compSvc: ComputeService,
  sheetCache: SheetCache,
  storageHost: string,
  storagePort: number
) {

  function createThruCache(sheet: Sheet): Promise<Sheet> {
    const url = `http://${storageHost}:${storagePort}/api/sheets`;
    const method = "POST";
    const headers = {
      'Content-Type': "application/json"
    };
    const body = JSON.stringify(sheet);

    return fetch(url, { method, headers, body })
      .then((res) => {
        console.log(`${method} ${url}\n => ${res.status}`);
        if (res.status !== 201) throw Error(`HTTP Status ${res.status}`);
        return res.json();
      })
      .then((json: object) => {
        const { cells, id } = json as {
          cells: SerializedValue[][];
          id: string;
        };
        const fullSheet = {
          ...(json as Sheet),
          cells: convertCellValues(cells)
        };

        sheetCache.loadCache(id, fullSheet);

        return fullSheet;
      });
  }

  function readThruCache(id: string): Promise<Sheet> {
    const url = `http://${storageHost}:${storagePort}/api/sheets/${id}`;

    console.log("Fetching: ", url);

    return fetch(url)
      .then((res) => {
        if (res.status === 404) throw "Not Found";
        if (res.status !== 200)
          throw new Error("HTTP Status ${response.status}");
        return res.json();
      })
      .then((json: unknown) => {
        const { cells } = json as { cells: SerializedValue[][] };
        const fullSheet = {
          ...(json as Sheet),
          cells: convertCellValues(cells)
        };

        sheetCache.loadCache(id, fullSheet);
        evaluateFormulas(id, fullSheet.cells, fullSheet.formulas);

        return fullSheet;
      });
  }

  function updateThruCache(
    id: string,
    patch: Sparse<SerializedValue>
  ): Promise<{values: Sparse<Value>, formulas: Sparse<string>}> {
    const url = `http://${storageHost}:${storagePort}/api/sheets/${id}/cells`;
    const method = "PATCH";
    const headers = {
      'Content-Type': "application/json"
    };
    const body = JSON.stringify(patch);

    console.log("Patching: ", url, body);

    return fetch(url, { method, headers, body })
      .then((res) => {
        if (res.status === 404) throw "Not Found";
        if (res.status !== 200)
          throw new Error("HTTP Status ${response.status}");
        return res.json();
      })
      .then((json: object) => {
        const changes = json as Sparse<SerializedValue> |
          { values: Sparse<SerializedValue>, formulas: Sparse<string> }
        let values = "values" in changes ? changes.values : changes;
        const entries = Object.keys(values)
          .map((k) => [k, Value.fromJSON(values[k as RCKey])]);
        const original = sheetCache.updateSheetValues(
          id,
          Object.fromEntries(entries)
        );
        const computed = original &&
          sheetCache.updateSheetValues(
            id,
            compSvc.updateValues(id, original)
          );

        if ("formulas" in changes) {
          const { formulas } = changes;
          const recomputed = compSvc.updateFormulas(id, formulas)
          return {
            values: { ...original, ...computed, ...recomputed },
            formulas
          }
        } else {
          return {
            values: { ...original, ...computed },
            formulas: {}
          }
        }
      })

  }

  function evaluateFormulas(
    id: string,
    cells: Value[][],
    formulas: Sparse<string> | undefined,
    rowOffset: number = 0
  ) {
    if ( formulas ) {
      const computed = compSvc.updateFormulas(id, formulas);
      Object.entries(computed).forEach(([key, value]) => {
        const { row, column } = parseKey(key as RCKey);
        cells[row-rowOffset][column] = value;
      });
    }
  }

  const router = Router();

  router.use(express.json({limit: "1Mb"}));

  router.post("/sheets", (req: Request, res: Response) => {
    const sheet = req.body as Sheet;

    console.log("Got POST for sheet");
    createThruCache(sheet)
      .then((sheet: Sheet) => {
        console.log("Sheet from storage:", sheet)
        res.status(201).send(sheet);
      })
      .catch((err: Error | string) => {
        console.log("Error: ", err);
        res.status(500).send(err);
      });
  });

  router.get("/sheets/:id", (req: Request, res: Response) => {
    const id = req.params.id;
    const sheetId = typeof id === "string" ? id : id[0];
    const limit = req.query["limit"];
    const maxRows = typeof limit === "string" ? parseInt(limit) : undefined;
    const tryCache = () => sheetCache.getSheetById(sheetId, maxRows);

    console.log(`GET /sheets/${sheetId}`);

    let cached = tryCache();

    if (cached) {
      console.log(`Sheet ${sheetId} resolved from cache.`);
      evaluateFormulas(sheetId, cached.cells, cached.formulas);
      res.send(cached);
    } else {
      console.log(`Sheet ${sheetId} is not in cache.`);
      readThruCache(sheetId)
        .then(() => {
          cached = tryCache();
          if (!cached) throw Error("Cache empty after read");
          evaluateFormulas(sheetId, cached.cells, cached.formulas);
          res.send(cached);
        })
        .catch((err: Error | string) => {
          console.log(`Error reading sheet ${sheetId}`, err);
          if (err === "Not Found") res.status(404).send();
          else res.status(500).send(err);
        });
    }
  });

  router.get("/sheets/:id/cells", (req: Request, res: Response) => {
    const id = req.params.id;
    const sheetId = typeof id === "string" ? id : id[0];
    const { limit, start } = req.query;
    const tryCache = () => sheetCache.getCellsInRange(
      sheetId,
      typeof start === "string" ? parseInt(start) : 0,
      typeof limit === "string" ? parseInt(limit) : undefined
    );

    let cached = tryCache();

    if (cached) {
      evaluateFormulas(sheetId, cached.rows, cached.formulas, cached.start);
      res.send(cached);
    } else {
      readThruCache(sheetId)
        .then(() => {
          cached = tryCache();
          if (!cached) throw Error("Cache empty after read");
          evaluateFormulas(sheetId, cached.rows, cached.formulas, cached.start);
          res.send(cached);
        })
        .catch((err: Error | string) => {
          if (err === "Not Found") res.status(404).send();
          else res.status(500).send(err);
        });
    }

  });

  router.patch("/sheets/:id/cells", (req: Request, res: Response) => {
    const id = req.params.id;
    const sheetId = typeof id === "string" ? id : id[0];
    const patch = req.body as Sparse<SerializedValue>;

    console.log(`PATCH /sheets/${sheetId}/cells`, patch);

    updateThruCache(sheetId, patch)
      .then((changes) => {
        console.log("Changes: ", changes);
        res.send(changes);
      })
      .catch((err: Error | string) => {
        console.log("Error:", err);
        if (err === "Not Found") res.status(404).send();
        else res.status(500).send(err);
      });
  });

  return router;
}

// helper functions

function convertCellValues(cells: SerializedValue[][]): Value[][] {
  return cells.map(
    (row) => row.map(
      (v) => Value.fromJSON(v)
    ));
}

export default createRouter;
